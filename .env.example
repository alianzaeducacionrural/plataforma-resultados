# Copiá este archivo a .env.local y completá los valores. .env.local está en .gitignore.

# URL del Web App de Apps Script (deployment). Ver README del backend.
VITE_API_URL=https://script.google.com/macros/s/AKfycbwY_RJy0FOYLHl-UJH-RLaQcb3k4tYJA63GBNpSOntvRoRjNc06LU-ugMqETRby5eCKqw/exec

# Token maestro SOLO para desarrollo local (así npm run dev no necesita ?token= en la URL).
# En producción el token viene siempre de la URL. No comitear este valor.
VITE_TOKEN_MAESTRO=
